<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      The J Player mark: a neon cyan play triangle in outline, with a smaller play formed
      inside it, centred on the navy tile the background layer paints. Bold strokes, so the
      glyph still reads at launcher sizes. Every shape stays inside the middle of the canvas,
      as a circular or pill launcher mask only guarantees the centre, and the Android 12
      splash screen is tighter still.
    -->
    <path
        android:fillColor="#00000000"
        android:pathData="M37,31 L79,54 L37,77 Z"
        android:strokeColor="#22E6FF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M48,42.5 L67,54 L48,65.5 Z"
        android:strokeColor="#22E6FF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
