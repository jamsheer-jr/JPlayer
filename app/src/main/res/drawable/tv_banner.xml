<?xml version="1.0" encoding="utf-8"?>
<!--
  Android TV launcher banner, 320x180: the J Player mark on its yellow, edge to edge
  (owner, v1.0.35: the yellow mark everywhere), the white play triangle centred with a
  clear margin on every side, so a launcher that crops a few percent for its focus
  animation still cannot touch it. A banner carries no words: the launcher writes the
  app's name under it itself.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
    <path
        android:fillColor="#FFD400"
        android:pathData="M0 0h320v180H0z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M128,48 L197,90 L128,132 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
