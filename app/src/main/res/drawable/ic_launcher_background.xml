<?xml version="1.0" encoding="utf-8"?>
<!--
  The tile's surface, flooded across the whole layer: a deep blue running into violet. The
  launcher crops this to whatever shape it likes, so it must be full bleed; the mark itself
  stays in the safe circle on the foreground layer.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#6D28D9"
        android:startColor="#1D4ED8"
        android:type="linear" />
</shape>
