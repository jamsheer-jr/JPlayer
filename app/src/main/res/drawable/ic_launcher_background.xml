<?xml version="1.0" encoding="utf-8"?>
<!--
  The tile's surface, flooded across the whole layer: the dark navy of the J Player mark
  (#050C1C). The launcher crops this to whatever shape it likes, so it must be full bleed;
  the glyph itself stays in the safe circle on the foreground layer.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#050C1C" />
</shape>
