    android:viewportHeight="108">
    <!--
      The J Player mark: the same filled white play triangle as
      ic_launcher_foreground, in one colour: Android throws the colours away and
      refills the layer with one wallpaper tint, using the drawn shape as the mask,
      so the themed and coloured icons sit identically.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,32 L77,54 L40,76 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
