<?xml version="1.0" encoding="utf-8"?>
<!--
  The Continue Watching widget (item 9c, v1.0.15): a title and up to four lines, each line a
  video and how much of it is left. Dark navy like the app's own mark. Every line is a tap
  target of its own; the provider fills the words and the intents.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#B9C4D6"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingVertical="5dp"
        android:textColor="#E8EEF7"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingVertical="5dp"
        android:textColor="#E8EEF7"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingVertical="5dp"
        android:textColor="#E8EEF7"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingVertical="5dp"
        android:textColor="#E8EEF7"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
